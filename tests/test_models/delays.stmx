<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>delays</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>20</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="total_in">
				<eqn>0</eqn>
				<inflow>f_in</inflow>
			</stock>
			<stock name="total_delay3_var">
				<eqn>0</eqn>
				<inflow>f_delay3_var</inflow>
			</stock>
			<stock name="total_delay1_var">
				<eqn>0</eqn>
				<inflow>f_delay1_var</inflow>
			</stock>
			<flow name="f_in">
				<eqn>input</eqn>
				<non_negative/>
			</flow>
			<flow name="f_delay3_var">
				<eqn>DELAY3(input, delay_time)</eqn>
				<non_negative/>
			</flow>
			<flow name="f_delay1_var">
				<eqn>DELAY1(input, delay_time)</eqn>
				<non_negative/>
			</flow>
			<aux name="input">
				<eqn>STEP(2, 5) + PULSE(10, 1, 0)</eqn>
			</aux>
			<aux name="delay_time">
				<eqn>2 + STEP(2, 8)</eqn>
			</aux>
			<aux name="delay_fixed">
				<eqn>DELAY(input, 3)</eqn>
			</aux>
			<aux name="delay_init">
				<eqn>DELAY(input, 3, 7)</eqn>
			</aux>
			<aux name="delay_expr">
				<eqn>DELAY(input * 2, 1 + 2, 3 + 4)</eqn>
			</aux>
			<aux name="delay_var">
				<eqn>DELAY(input, delay_time)</eqn>
			</aux>
			<aux name="delay_off_grid">
				<eqn>DELAY(input, 2.1)</eqn>
			</aux>
			<aux name="d1">
				<eqn>DELAY1(input, 3)</eqn>
			</aux>
			<aux name="d1_init">
				<eqn>DELAY1(input, 3, 4)</eqn>
			</aux>
			<aux name="d3">
				<eqn>DELAY3(input, 3)</eqn>
			</aux>
			<aux name="d3_init">
				<eqn>DELAY3(input, 3, 4)</eqn>
			</aux>
			<aux name="dn">
				<eqn>DELAYN(input, 3, 5)</eqn>
			</aux>
			<aux name="dn_init">
				<eqn>DELAYN(input, 3, 5, 4)</eqn>
			</aux>
			<aux name="hist">
				<eqn>HISTORY(input, TIME - 2)</eqn>
			</aux>
			<aux name="hist_before_start">
				<eqn>HISTORY(input, TIME - 30)</eqn>
			</aux>
			<aux name="prev">
				<eqn>PREVIOUS(input, 0)</eqn>
			</aux>
			<aux name="prev_init">
				<eqn>PREVIOUS(input, 99)</eqn>
			</aux>
			<aux name="prev_init_expr">
				<eqn>PREVIOUS(input, 5 + 5)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<stock x="350" y="100" name="total_in"/>
				<stock x="350" y="270" name="total_delay3_var"/>
				<stock x="350" y="440" name="total_delay1_var"/>
				<flow label_side="bottom" x="238.75" y="100.0" name="f_in">
					<pts>
						<pt x="150" y="100"/>
						<pt x="327.5" y="100"/>
					</pts>
				</flow>
				<flow label_side="bottom" x="238.75" y="270.0" name="f_delay3_var">
					<pts>
						<pt x="150" y="270"/>
						<pt x="327.5" y="270"/>
					</pts>
				</flow>
				<flow label_side="bottom" x="238.75" y="440.0" name="f_delay1_var">
					<pts>
						<pt x="150" y="440"/>
						<pt x="327.5" y="440"/>
					</pts>
				</flow>
				<aux x="80" y="630" name="input"/>
				<aux x="220" y="630" name="delay_time"/>
				<aux x="360" y="630" name="delay_fixed"/>
				<aux x="500" y="630" name="delay_init"/>
				<aux x="640" y="630" name="delay_expr"/>
				<aux x="780" y="630" name="delay_var"/>
				<aux x="80" y="720" name="delay_off_grid"/>
				<aux x="220" y="720" name="d1"/>
				<aux x="360" y="720" name="d1_init"/>
				<aux x="500" y="720" name="d3"/>
				<aux x="640" y="720" name="d3_init"/>
				<aux x="780" y="720" name="dn"/>
				<aux x="80" y="810" name="dn_init"/>
				<aux x="220" y="810" name="hist"/>
				<aux x="360" y="810" name="hist_before_start"/>
				<aux x="500" y="810" name="prev"/>
				<aux x="640" y="810" name="prev_init"/>
				<aux x="780" y="810" name="prev_init_expr"/>
				<connector uid="1" angle="270">
					<from>input</from>
					<to>f_in</to>
				</connector>
				<connector uid="2" angle="270">
					<from>delay_time</from>
					<to>f_delay3_var</to>
				</connector>
				<connector uid="3" angle="270">
					<from>input</from>
					<to>f_delay3_var</to>
				</connector>
				<connector uid="4" angle="270">
					<from>delay_time</from>
					<to>f_delay1_var</to>
				</connector>
				<connector uid="5" angle="270">
					<from>input</from>
					<to>f_delay1_var</to>
				</connector>
				<connector uid="6" angle="270">
					<from>input</from>
					<to>delay_fixed</to>
				</connector>
				<connector uid="7" angle="270">
					<from>input</from>
					<to>delay_init</to>
				</connector>
				<connector uid="8" angle="270">
					<from>input</from>
					<to>delay_expr</to>
				</connector>
				<connector uid="9" angle="270">
					<from>delay_time</from>
					<to>delay_var</to>
				</connector>
				<connector uid="10" angle="270">
					<from>input</from>
					<to>delay_var</to>
				</connector>
				<connector uid="11" angle="270">
					<from>input</from>
					<to>delay_off_grid</to>
				</connector>
				<connector uid="12" angle="270">
					<from>input</from>
					<to>d1</to>
				</connector>
				<connector uid="13" angle="270">
					<from>input</from>
					<to>d1_init</to>
				</connector>
				<connector uid="14" angle="270">
					<from>input</from>
					<to>d3</to>
				</connector>
				<connector uid="15" angle="270">
					<from>input</from>
					<to>d3_init</to>
				</connector>
				<connector uid="16" angle="270">
					<from>input</from>
					<to>dn</to>
				</connector>
				<connector uid="17" angle="270">
					<from>input</from>
					<to>dn_init</to>
				</connector>
				<connector uid="18" angle="270">
					<from>input</from>
					<to>hist</to>
				</connector>
				<connector uid="19" angle="270">
					<from>input</from>
					<to>hist_before_start</to>
				</connector>
				<connector uid="20" angle="270">
					<from>input</from>
					<to>prev</to>
				</connector>
				<connector uid="21" angle="270">
					<from>input</from>
					<to>prev_init</to>
				</connector>
				<connector uid="22" angle="270">
					<from>input</from>
					<to>prev_init_expr</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>
