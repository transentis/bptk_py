	</model_units>
	<model>
		<variables>
			<aux name="a">
				<eqn>1</eqn>
			</aux>
			<aux name="b">
				<eqn>2 + TIME</eqn>
			</aux>
			<aux name="rate">
				<eqn>0.1</eqn>
				<units>1/Months</units>
			</aux>
			<aux name="total">
				<eqn>a + b</eqn>
				<isee:summing/>
			</aux>
			<aux name="smoothed">
				<eqn>SMTH1(b, 3)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="delayed">
				<eqn>DELAY(b, 2)</eqn>
				<isee:delay_aux/>
			</aux>
			<stock name="level">
				<eqn>10</eqn>
				<inflow>growth</inflow>
				<outflow>shrinking</outflow>
				<non_negative/>
			</stock>
			<flow name="growth">
				<eqn>level * rate</eqn>
				<non_negative/>
			</flow>
			<flow name="shrinking">
				<eqn>TIME</eqn>
				<non_negative/>
				<gf>
					<xscale min="0" max="12"/>
					<yscale min="0" max="100"/>
					<ypts>0,1,3,1,0</ypts>
				</gf>
			</flow>
			<aux name="growth path score">
				<eqn>PATHSCORE(level, growth, level)</eqn>
			</aux>
			<aux name="growth link score">
				<eqn>PATHSCORE(level, growth)</eqn>
			</aux>
			<aux name="pathway r1">
				<eqn>PATHSCORE(level, growth, level)</eqn>
				<isee:pathscore/>
				<units>dmnl</units>
			</aux>
			<aux name="loop r1">
				<eqn>LOOPSCORE(level, growth)</eqn>
				<isee:loopscore/>
				<units>dmnl</units>
			</aux>
			<aux name="a doubled">
				<eqn>a*2</eqn>
			</aux>
			<module name="inner" isee:label="">
				<connect to=".x" from="inner.x"/>
				<connect2 to="x" from="inner.x"/>
			</module>
			<aux name="x" access="input">
				<eqn>5</eqn>
			</aux>
			<aux name="from inner">
				<eqn>x + a</eqn>
			</aux>
		</variables>
