<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>math_rounding</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>5</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="arccos_value">
				<eqn>ARCCOS(0.5)</eqn>
			</aux>
			<aux name="arcsin_value">
				<eqn>ARCSIN(0.5)</eqn>
			</aux>
			<aux name="arctan_value">
				<eqn>ARCTAN(1)</eqn>
			</aux>
			<aux name="int_value">
				<eqn>INT(-2.5)</eqn>
			</aux>
			<aux name="mod_value">
				<eqn>7 MOD 3</eqn>
			</aux>
			<aux name="round_half">
				<eqn>ROUND(2.5)</eqn>
			</aux>
			<aux name="mod_negative_left">
				<eqn>-7 MOD 3</eqn>
			</aux>
			<aux name="mod_negative_right">
				<eqn>7 MOD -3</eqn>
			</aux>
			<aux name="round_negative_half">
				<eqn>ROUND(-2.5)</eqn>
			</aux>
			<aux name="round_half_odd">
				<eqn>ROUND(3.5)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="120" y="100" name="arccos_value"/>
				<aux x="280" y="100" name="arcsin_value"/>
				<aux x="440" y="100" name="arctan_value"/>
				<aux x="600" y="100" name="int_value"/>
				<aux x="120" y="210" name="mod_value"/>
				<aux x="280" y="210" name="round_half"/>
				<aux x="600" y="210" name="mod_negative_left"/>
				<aux x="120" y="320" name="mod_negative_right"/>
				<aux x="280" y="320" name="round_negative_half"/>
				<aux x="440" y="320" name="round_half_odd"/>
			</view>
		</views>
	</model>
</xmile>
