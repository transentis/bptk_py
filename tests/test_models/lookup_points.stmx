<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>lookup_points</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>12</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<dimensions>
		<dim name="D" size="2"/>
	</dimensions>
	<model>
		<variables>
			<aux name="gf_uneven">
				<eqn>TIME</eqn>
				<gf>
					<xpts>0,1,3,7,10</xpts>
					<yscale min="0" max="8"/>
					<ypts>0,5,6,2,8</ypts>
				</gf>
			</aux>
			<aux name="gf_uneven_lookup">
				<eqn>LOOKUP(gf_uneven, TIME - 1)</eqn>
			</aux>
			<aux name="gf_per_element">
				<dimensions>
					<dim name="D"/>
				</dimensions>
				<element subscript="1">
					<eqn>TIME</eqn>
					<gf>
						<xscale min="0" max="10"/>
						<yscale min="0" max="20"/>
						<ypts>0,10,20</ypts>
					</gf>
				</element>
				<element subscript="2">
					<eqn>TIME</eqn>
					<gf>
						<xpts>0,2,10</xpts>
						<yscale min="0" max="5"/>
						<ypts>5,0,5</ypts>
					</gf>
				</element>
			</aux>
			<aux name="gf_per_element_sum">
				<eqn>SUM(gf_per_element[*])</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="80" y="290" name="gf_uneven"/>
				<aux x="220" y="290" name="gf_uneven_lookup"/>
				<aux x="360" y="290" name="gf_per_element"/>
				<aux x="500" y="290" name="gf_per_element_sum"/>
				<connector uid="1" angle="270">
					<from>gf_uneven</from>
					<to>gf_uneven_lookup</to>
				</connector>
				<connector uid="2" angle="270">
					<from>gf_per_element</from>
					<to>gf_per_element_sum</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>
