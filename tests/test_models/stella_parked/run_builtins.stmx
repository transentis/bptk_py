<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>run_builtins</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>10</stop>
		<dt>1</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="counting">
				<eqn>PREVIOUS(SELF, 0) + 1</eqn>
			</aux>
			<aux name="doubling">
				<eqn>PREVIOUS(SELF, 1) * 2</eqn>
			</aux>
			<aux name="source">
				<eqn>TIME * 3</eqn>
			</aux>
			<aux name="end_of_last_run">
				<eqn>ENDVAL(source, -1)</eqn>
			</aux>
			<aux name="clock">
				<eqn>CLOCKTIME</eqn>
			</aux>
			<aux name="run_number">
				<eqn>RUNCOUNT</eqn>
			</aux>
			<aux name="sensi_run_number">
				<eqn>SENSIRUNCOUNT</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="80" y="290" name="counting"/>
				<aux x="220" y="290" name="doubling"/>
				<aux x="360" y="290" name="source"/>
				<aux x="500" y="290" name="end_of_last_run"/>
				<aux x="640" y="290" name="clock"/>
				<aux x="780" y="290" name="run_number"/>
				<aux x="80" y="380" name="sensi_run_number"/>
				<connector uid="1" angle="270">
					<from>source</from>
					<to>end_of_last_run</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>
