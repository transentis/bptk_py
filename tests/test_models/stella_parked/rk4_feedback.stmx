<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>rk4_feedback</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="RK4" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>10</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="decaying">
				<eqn>100</eqn>
				<outflow>decay</outflow>
			</stock>
			<flow name="decay">
				<eqn>decaying * 0.3</eqn>
				<non_negative/>
			</flow>
			<stock name="logistic_growth">
				<eqn>1</eqn>
				<inflow>growth</inflow>
			</stock>
			<flow name="growth">
				<eqn>0.8 * logistic_growth * (1 - logistic_growth / 100)</eqn>
				<non_negative/>
			</flow>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<stock x="350" y="100" name="decaying"/>
				<flow label_side="bottom" x="461.25" y="100.0" name="decay">
					<pts>
						<pt x="372.5" y="100"/>
						<pt x="550" y="100"/>
					</pts>
				</flow>
				<stock x="350" y="270" name="logistic_growth"/>
				<flow label_side="bottom" x="238.75" y="270.0" name="growth">
					<pts>
						<pt x="150" y="270"/>
						<pt x="327.5" y="270"/>
					</pts>
				</flow>
				<connector uid="1" angle="270">
					<from>decaying</from>
					<to>decay</to>
				</connector>
				<connector uid="2" angle="270">
					<from>logistic_growth</from>
					<to>growth</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>
