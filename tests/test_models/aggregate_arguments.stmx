<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>aggregate_arguments</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>1</start>
		<stop>13</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="a">
				<eqn>2.5</eqn>
			</aux>
			<aux name="b">
				<eqn>3</eqn>
			</aux>
			<aux name="mean two">
				<eqn>MEAN(a, b)</eqn>
			</aux>
			<aux name="mean three">
				<eqn>MEAN(a, b, TIME)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1400" page_height="1200" type="stock_flow">
				<aux x="80" y="80" name="a"/>
				<aux x="240" y="80" name="b"/>
				<aux x="400" y="80" name="mean two"/>
				<aux x="560" y="80" name="mean three"/>
				<connector uid="1" angle="270"><from>a</from><to>mean_two</to></connector>
				<connector uid="2" angle="270"><from>b</from><to>mean_two</to></connector>
				<connector uid="3" angle="270"><from>a</from><to>mean_three</to></connector>
				<connector uid="4" angle="270"><from>b</from><to>mean_three</to></connector>
			</view>
		</views>
	</model>
</xmile>
