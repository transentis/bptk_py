<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>stella_extras</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>12</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<dimensions>
		<dim name="E" size="5"/>
	</dimensions>
	<model>
		<variables>
			<aux name="input">
				<eqn>SINWAVE(5, 6) + TIME</eqn>
			</aux>
			<aux name="isnan_number">
				<eqn>ISNAN(input)</eqn>
			</aux>
			<aux name="isnan_nan">
				<eqn>ISNAN(NAN)</eqn>
			</aux>
			<aux name="expbound_slow_start">
				<eqn>EXPBOUND(1, 9, TIME, 2, 2, 8)</eqn>
			</aux>
			<aux name="expbound_linear">
				<eqn>EXPBOUND(1, 9, TIME, 0, 2, 8)</eqn>
			</aux>
			<aux name="expbound_fast_start">
				<eqn>EXPBOUND(1, 9, TIME, -2, 2, 8)</eqn>
			</aux>
			<aux name="logisticbound_open">
				<eqn>LOGISTICBOUND(1, 9, TIME, 5, 1)</eqn>
			</aux>
			<aux name="logisticbound_closed">
				<eqn>LOGISTICBOUND(1, 9, TIME, 5, 1, 1, 10)</eqn>
			</aux>
			<aux name="logisticbound_linear">
				<eqn>LOGISTICBOUND(1, 9, TIME, 5, 0, 1, 10)</eqn>
			</aux>
			<aux name="maxsoft_1">
				<eqn>MAXSOFT(6 - TIME, 1, 2)</eqn>
			</aux>
			<aux name="maxsoft_hard">
				<eqn>MAXSOFT(6 - TIME, 1, 0)</eqn>
			</aux>
			<aux name="minsoft_1">
				<eqn>MINSOFT(TIME, 7, 2)</eqn>
			</aux>
			<aux name="runcum_1">
				<eqn>RUNCUM(input)</eqn>
			</aux>
			<aux name="runcum_as_stock">
				<eqn>RUNCUM(input, STARTTIME, TIME - DT)</eqn>
			</aux>
			<aux name="runcum_window">
				<eqn>RUNCUM(input, TIME - 2, TIME)</eqn>
			</aux>
			<aux name="runmax_1">
				<eqn>RUNMAX(input)</eqn>
			</aux>
			<aux name="runmin_1">
				<eqn>RUNMIN(input)</eqn>
			</aux>
			<aux name="runmean_1">
				<eqn>RUNMEAN(input)</eqn>
			</aux>
			<aux name="runmean_window">
				<eqn>RUNMEAN(input, TIME - 3, TIME)</eqn>
			</aux>
			<aux name="runcumtarget_constant">
				<eqn>RUNCUMTARGET(1, 6)</eqn>
			</aux>
			<aux name="runcumtarget_input">
				<eqn>RUNCUMTARGET(input, 20)</eqn>
			</aux>
			<aux name="gf_shape">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2" max="10"/>
					<yscale min="0" max="20"/>
					<ypts>0,5,20,10,0</ypts>
				</gf>
			</aux>
			<aux name="lookupmax_1">
				<eqn>LOOKUPMAX(gf_shape)</eqn>
			</aux>
			<aux name="lookupmin_1">
				<eqn>LOOKUPMIN(gf_shape)</eqn>
			</aux>
			<aux name="lookupmean_1">
				<eqn>LOOKUPMEAN(gf_shape)</eqn>
			</aux>
			<aux name="lookupmax_range">
				<eqn>LOOKUPMAX(gf_shape, 5, 3)</eqn>
			</aux>
			<aux name="lookupmean_range">
				<eqn>LOOKUPMEAN(gf_shape, 8)</eqn>
			</aux>
			<aux name="values">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>3</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>4</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>5</eqn>
				</element>
			</aux>
			<aux name="weights">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>6</eqn>
				</element>
			</aux>
			<aux name="percentile_50">
				<eqn>PERCENTILE(values, 50)</eqn>
			</aux>
			<aux name="percentile_25">
				<eqn>PERCENTILE(values, 25)</eqn>
			</aux>
			<aux name="percentile_0">
				<eqn>PERCENTILE(values, 0)</eqn>
			</aux>
			<aux name="percentile_100">
				<eqn>PERCENTILE(values, 100)</eqn>
			</aux>
			<aux name="percentile_difference">
				<eqn>PERCENTILE(values, 50, 25)</eqn>
			</aux>
			<aux name="percentile_weighted">
				<eqn>PERCENTILE(values, 50, 0, weights)</eqn>
			</aux>
			<aux name="weights_first">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>4</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
			</aux>
			<aux name="maxsoft_half">
				<eqn>MAXSOFT(6 - TIME, 1, 0.5)</eqn>
			</aux>
			<aux name="maxsoft_5">
				<eqn>MAXSOFT(6 - TIME, 1, 5)</eqn>
			</aux>
			<aux name="maxsoft_equal">
				<eqn>MAXSOFT(TIME, TIME, 2)</eqn>
			</aux>
			<aux name="minsoft_half">
				<eqn>MINSOFT(TIME, 7, 0.5)</eqn>
			</aux>
			<aux name="minsoft_5">
				<eqn>MINSOFT(TIME, 7, 5)</eqn>
			</aux>
			<aux name="percentile_10">
				<eqn>PERCENTILE(values, 10)</eqn>
			</aux>
			<aux name="percentile_40">
				<eqn>PERCENTILE(values, 40)</eqn>
			</aux>
			<aux name="percentile_60">
				<eqn>PERCENTILE(values, 60)</eqn>
			</aux>
			<aux name="percentile_75">
				<eqn>PERCENTILE(values, 75)</eqn>
			</aux>
			<aux name="percentile_90">
				<eqn>PERCENTILE(values, 90)</eqn>
			</aux>
			<aux name="percentile_cut_75_25">
				<eqn>PERCENTILE(values, 75, 25)</eqn>
			</aux>
			<aux name="percentile_cut_90_10">
				<eqn>PERCENTILE(values, 90, 10)</eqn>
			</aux>
			<aux name="percentile_weighted_25">
				<eqn>PERCENTILE(values, 25, 0, weights)</eqn>
			</aux>
			<aux name="percentile_weighted_75">
				<eqn>PERCENTILE(values, 75, 0, weights)</eqn>
			</aux>
			<aux name="percentile_weighted_first">
				<eqn>PERCENTILE(values, 50, 0, weights_first)</eqn>
			</aux>
			<aux name="percentile_weighted_cut">
				<eqn>PERCENTILE(values, 75, 25, weights)</eqn>
			</aux>
			<aux name="runmax_window">
				<eqn>RUNMAX(input, TIME - 2, TIME)</eqn>
			</aux>
			<aux name="runmin_window">
				<eqn>RUNMIN(input, TIME - 2, TIME)</eqn>
			</aux>
			<aux name="runcumtarget_never">
				<eqn>RUNCUMTARGET(1, 100)</eqn>
			</aux>
			<aux name="runcumtarget_falling">
				<eqn>RUNCUMTARGET(6 - TIME, 10)</eqn>
			</aux>
			<aux name="lookupmean_range_3_5">
				<eqn>LOOKUPMEAN(gf_shape, 3, 5)</eqn>
			</aux>
			<aux name="lookupmin_range_3_5">
				<eqn>LOOKUPMIN(gf_shape, 3, 5)</eqn>
			</aux>
					<aux name="gf_const">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2" max="10"/>
					<yscale min="0" max="2"/>
					<ypts>1,1,1,1,1</ypts>
				</gf>
			</aux>
			<aux name="gf_shape_from_0">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="0" max="8"/>
					<yscale min="0" max="20"/>
					<ypts>0,5,20,10,0</ypts>
				</gf>
			</aux>
			<aux name="values_sorted">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>2</eqn>
				</element>
				<element subscript="3">
					<eqn>3</eqn>
				</element>
				<element subscript="4">
					<eqn>4</eqn>
				</element>
				<element subscript="5">
					<eqn>5</eqn>
				</element>
			</aux>
			<aux name="values_orig">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>3</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>4</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>5</eqn>
				</element>
			</aux>
			<aux name="w_equal">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
			</aux>
			<aux name="w_first_2">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>2</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
			</aux>
			<aux name="w_last_2">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>2</eqn>
				</element>
			</aux>
			<aux name="w_middle_3">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>3</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
			</aux>
			<aux name="w_last_half">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>0.5</eqn>
				</element>
			</aux>
			<aux name="w_last_6">
				<dimensions>
					<dim name="E"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>6</eqn>
				</element>
			</aux>
			<aux name="p">
				<eqn>TIME * 100 / 12</eqn>
			</aux>
			<aux name="lookupmean_const">
				<eqn>LOOKUPMEAN(gf_const)</eqn>
			</aux>
			<aux name="lookupmean_const_8">
				<eqn>LOOKUPMEAN(gf_const, 8)</eqn>
			</aux>
			<aux name="lookupmean_const_4">
				<eqn>LOOKUPMEAN(gf_const, 4)</eqn>
			</aux>
			<aux name="lookupmean_const_3_5">
				<eqn>LOOKUPMEAN(gf_const, 3, 5)</eqn>
			</aux>
			<aux name="lookupmean_const_5_3">
				<eqn>LOOKUPMEAN(gf_const, 5, 3)</eqn>
			</aux>
			<aux name="lookupmean_const_4_8">
				<eqn>LOOKUPMEAN(gf_const, 4, 8)</eqn>
			</aux>
			<aux name="lookupmean_const_8_4">
				<eqn>LOOKUPMEAN(gf_const, 8, 4)</eqn>
			</aux>
			<aux name="lookupmean_const_6_10">
				<eqn>LOOKUPMEAN(gf_const, 6, 10)</eqn>
			</aux>
			<aux name="lookupmean_shape_4_8">
				<eqn>LOOKUPMEAN(gf_shape, 4, 8)</eqn>
			</aux>
			<aux name="lookupmean_shape_8_4">
				<eqn>LOOKUPMEAN(gf_shape, 8, 4)</eqn>
			</aux>
			<aux name="lookupmean_shape_5_3">
				<eqn>LOOKUPMEAN(gf_shape, 5, 3)</eqn>
			</aux>
			<aux name="lookupmean_shape_6">
				<eqn>LOOKUPMEAN(gf_shape, 6)</eqn>
			</aux>
			<aux name="lookupmean_shape_from_0">
				<eqn>LOOKUPMEAN(gf_shape_from_0)</eqn>
			</aux>
			<aux name="lookupmean_shape_from_0_1_3">
				<eqn>LOOKUPMEAN(gf_shape_from_0, 1, 3)</eqn>
			</aux>
			<aux name="percentile_sorted">
				<eqn>PERCENTILE(values_sorted, p)</eqn>
			</aux>
			<aux name="percentile_orig">
				<eqn>PERCENTILE(values_orig, p)</eqn>
			</aux>
			<aux name="percentile_w_equal">
				<eqn>PERCENTILE(values_sorted, p, 0, w_equal)</eqn>
			</aux>
			<aux name="percentile_w_first_2">
				<eqn>PERCENTILE(values_sorted, p, 0, w_first_2)</eqn>
			</aux>
			<aux name="percentile_w_last_2">
				<eqn>PERCENTILE(values_sorted, p, 0, w_last_2)</eqn>
			</aux>
			<aux name="percentile_w_middle_3">
				<eqn>PERCENTILE(values_sorted, p, 0, w_middle_3)</eqn>
			</aux>
			<aux name="percentile_w_last_half">
				<eqn>PERCENTILE(values_sorted, p, 0, w_last_half)</eqn>
			</aux>
			<aux name="percentile_orig_w_last_6">
				<eqn>PERCENTILE(values_orig, p, 0, w_last_6)</eqn>
			</aux>
			<aux name="in_const_2">
				<eqn>2</eqn>
			</aux>
			<aux name="in_step">
				<eqn>STEP(4, 3)</eqn>
			</aux>
			<aux name="in_ramp">
				<eqn>TIME</eqn>
			</aux>
			<aux name="in_pulse">
				<eqn>IF TIME = 2 THEN 10 ELSE 0</eqn>
			</aux>
			<aux name="in_sin">
				<eqn>SINWAVE(5, 6) + TIME</eqn>
			</aux>
			<aux name="runcumtarget_const_7">
				<eqn>RUNCUMTARGET(in_const_2, 7)</eqn>
			</aux>
			<aux name="runcumtarget_step_10">
				<eqn>RUNCUMTARGET(in_step, 10)</eqn>
			</aux>
			<aux name="runcumtarget_ramp_20">
				<eqn>RUNCUMTARGET(in_ramp, 20)</eqn>
			</aux>
			<aux name="runcumtarget_ramp_3">
				<eqn>RUNCUMTARGET(in_ramp, 3)</eqn>
			</aux>
			<aux name="runcumtarget_pulse_4">
				<eqn>RUNCUMTARGET(in_pulse, 4)</eqn>
			</aux>
			<aux name="runcumtarget_sin_10">
				<eqn>RUNCUMTARGET(in_sin, 10)</eqn>
			</aux>
			<aux name="runcumtarget_sin_20">
				<eqn>RUNCUMTARGET(in_sin, 20)</eqn>
			</aux>
			<aux name="runcumtarget_sin_30">
				<eqn>RUNCUMTARGET(in_sin, 30)</eqn>
			</aux>
			<aux name="runcum_sin">
				<eqn>RUNCUM(in_sin)</eqn>
			</aux>
			<aux name="runcum_ramp">
				<eqn>RUNCUM(in_ramp)</eqn>
			</aux>
</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="1810" type="stock_flow">
				<aux x="80" y="290" name="input"/>
				<aux x="220" y="290" name="isnan_number"/>
				<aux x="360" y="290" name="isnan_nan"/>
