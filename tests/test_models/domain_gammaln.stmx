<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>domain_gammaln</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>4</stop>
		<dt>1</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="gammaln neg">
				<eqn>GAMMALN(-2.5)</eqn>
			</aux>
			<aux name="gammaln pole">
				<eqn>GAMMALN(-2)</eqn>
			</aux>
			<aux name="g minus 0 5">
				<eqn>GAMMALN(-0.5)</eqn>
			</aux>
			<aux name="g minus 1 5">
				<eqn>GAMMALN(-1.5)</eqn>
			</aux>
			<aux name="g minus 3 5">
				<eqn>GAMMALN(-3.5)</eqn>
			</aux>
			<aux name="g 0">
				<eqn>GAMMALN(0)</eqn>
			</aux>
			<aux name="g 0 1">
				<eqn>GAMMALN(0.1)</eqn>
			</aux>
			<aux name="g 0 5">
				<eqn>GAMMALN(0.5)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="80" y="120" name="gammaln neg"/>
				<aux x="210" y="120" name="gammaln pole"/>
				<aux x="340" y="120" name="g minus 0 5"/>
				<aux x="470" y="120" name="g minus 1 5"/>
				<aux x="600" y="120" name="g minus 3 5"/>
				<aux x="730" y="120" name="g 0"/>
				<aux x="80" y="240" name="g 0 1"/>
				<aux x="210" y="240" name="g 0 5"/>

			</view>
		</views>
	</model>
</xmile>
