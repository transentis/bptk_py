<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>init</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0</start>
		<stop>5</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="source">
				<eqn>TIME + 3</eqn>
			</aux>
			<aux name="init_time">
				<eqn>INIT(TIME * 2 + 1)</eqn>
			</aux>
			<aux name="init_variable">
				<eqn>INIT(source) * 10</eqn>
			</aux>
			<aux name="init_in_expression">
				<eqn>TIME - INIT(TIME)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="120" y="100" name="source"/>
				<aux x="280" y="100" name="init_time"/>
				<aux x="440" y="100" name="init_variable"/>
				<connector uid="1" angle="270">
					<from>source</from>
					<to>init_variable</to>
				</connector>
				<aux x="600" y="100" name="init_in_expression"/>
			</view>
		</views>
	</model>
</xmile>
