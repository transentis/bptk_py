<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>random_dt_quarter</name>
		<vendor>isee systems, inc.</vendor>
		<product version="1.9.2" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Months" isee:instantaneous_flows="false">
		<start>0.5</start>
		<stop>2500</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="normal_1">
				<eqn>NORMAL(10, 2)</eqn>
			</aux>
			<aux name="normal_truncated">
				<eqn>NORMAL(0, 1, 5, -1, 1)</eqn>
			</aux>
			<aux name="lognormal_1">
				<eqn>LOGNORMAL(10, 2)</eqn>
			</aux>
			<aux name="exprnd_1">
				<eqn>EXPRND(4)</eqn>
			</aux>
			<aux name="gamma_1">
				<eqn>GAMMA(2, 3)</eqn>
			</aux>
			<aux name="weibull_1">
				<eqn>WEIBULL(2, 3)</eqn>
			</aux>
			<aux name="geometric_1">
				<eqn>GEOMETRIC(0.25)</eqn>
			</aux>
			<aux name="negbinomial_1">
				<eqn>NEGBINOMIAL(3, 0.4)</eqn>
			</aux>
			<aux name="pareto_1">
				<eqn>PARETO(3, 2)</eqn>
			</aux>
			<aux name="poisson_1">
				<eqn>POISSON(4)</eqn>
			</aux>
			<aux name="binomial_1">
				<eqn>BINOMIAL(10, 0.3)</eqn>
			</aux>
			<aux name="triangular_1">
				<eqn>TRIANGULAR(1, 2, 6)</eqn>
			</aux>
			<aux name="logistic_1">
				<eqn>LOGISTIC(5, 2)</eqn>
			</aux>
			<aux name="random_1">
				<eqn>RANDOM(2, 8)</eqn>
			</aux>
			<aux name="random_seed_a">
				<eqn>RANDOM(0, 1, 7)</eqn>
			</aux>
			<aux name="random_seed_b">
				<eqn>RANDOM(0, 1, 7)</eqn>
			</aux>
			<aux name="montecarlo_1">
				<eqn>MONTECARLO(50)</eqn>
			</aux>
			<aux name="normal_sample_1">
				<eqn>NORMAL(0, 1, 31, NAN, NAN, 1)</eqn>
			</aux>
			<aux name="uniform_sample_2">
				<eqn>UNIFORM(0, 1, 32, NAN, NAN, 2)</eqn>
			</aux>
			<aux name="normal_sample_0_1">
				<eqn>NORMAL(0, 1, 34, NAN, NAN, 0.1)</eqn>
			</aux>
			<aux name="normal_sample_0_3">
				<eqn>NORMAL(0, 1, 33, NAN, NAN, 0.3)</eqn>
			</aux>
			<aux name="normal_sample_0_4">
				<eqn>NORMAL(0, 1, 61, NAN, NAN, 0.4)</eqn>
			</aux>
			<aux name="normal_sample_0_5">
				<eqn>NORMAL(0, 1, 62, NAN, NAN, 0.5)</eqn>
			</aux>
			<aux name="normal_sample_0_6">
				<eqn>NORMAL(0, 1, 63, NAN, NAN, 0.6)</eqn>
			</aux>
			<aux name="normal_sample_0_75">
				<eqn>NORMAL(0, 1, 64, NAN, NAN, 0.75)</eqn>
			</aux>
			<aux name="normal_sample_1_1">
				<eqn>NORMAL(0, 1, 65, NAN, NAN, 1.1)</eqn>
			</aux>
			<aux name="normal_sample_bounded">
				<eqn>NORMAL(0, 1, 35, -1, 1, 1)</eqn>
			</aux>
			<aux name="poisson_sample_1">
				<eqn>POISSON(4, 36, NAN, NAN, 1)</eqn>
			</aux>
			<aux name="montecarlo_sample_1">
				<eqn>MONTECARLO(50, 37, NAN, NAN, 1)</eqn>
			</aux>
			<aux name="normal_every_dt">
				<eqn>NORMAL(0, 1, 38)</eqn>
			</aux>
			<aux name="normalpink_5">
				<eqn>NORMALPINK(10, 2, 5)</eqn>
			</aux>
			<aux name="normalpink_1">
				<eqn>NORMALPINK(10, 2, 1)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1000" page_height="800" type="stock_flow">
				<aux x="80" y="80" name="normal_1"/>
				<aux x="220" y="80" name="normal_truncated"/>
				<aux x="360" y="80" name="lognormal_1"/>
				<aux x="500" y="80" name="exprnd_1"/>
				<aux x="640" y="80" name="gamma_1"/>
				<aux x="780" y="80" name="weibull_1"/>
				<aux x="920" y="80" name="geometric_1"/>
				<aux x="80" y="170" name="negbinomial_1"/>
				<aux x="220" y="170" name="pareto_1"/>
				<aux x="360" y="170" name="poisson_1"/>
				<aux x="500" y="170" name="binomial_1"/>
				<aux x="640" y="170" name="triangular_1"/>
				<aux x="780" y="170" name="logistic_1"/>
				<aux x="920" y="170" name="random_1"/>
				<aux x="80" y="260" name="random_seed_a"/>
				<aux x="220" y="260" name="random_seed_b"/>
				<aux x="360" y="260" name="montecarlo_1"/>
				<aux x="500" y="260" name="normal_sample_1"/>
				<aux x="640" y="260" name="uniform_sample_2"/>
				<aux x="780" y="260" name="normal_sample_0_1"/>
				<aux x="920" y="260" name="normal_sample_0_3"/>
				<aux x="80" y="350" name="normal_sample_0_4"/>
				<aux x="220" y="350" name="normal_sample_0_5"/>
				<aux x="360" y="350" name="normal_sample_0_6"/>
				<aux x="500" y="350" name="normal_sample_0_75"/>
				<aux x="640" y="350" name="normal_sample_1_1"/>
				<aux x="780" y="350" name="normal_sample_bounded"/>
				<aux x="920" y="350" name="poisson_sample_1"/>
				<aux x="80" y="440" name="montecarlo_sample_1"/>
				<aux x="220" y="440" name="normal_every_dt"/>
				<aux x="80" y="530" name="normalpink_5"/>
				<aux x="220" y="530" name="normalpink_1"/>
			</view>
		</views>
	</model>
</xmile>
